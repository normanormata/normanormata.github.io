---
# Section-level content index for gitbook-plugin-search-pro
layout: null
---

{%- assign index = "" | split: "" -%}
{%- assign excluded_files = site.gitbook_search.exclude.files -%}
{%- assign excluded_tags = site.gitbook_search.exclude.tags | uniq -%}
{%- assign excluded_categories = site.gitbook_search.exclude.categories | uniq -%}
{%- assign excluded_taxonomies = excluded_tags | concat: excluded_categories | uniq -%}
{%- for collection in site.collections -%}
  {%- if collection.output -%}
    {%- for post in site[collection.label] -%}
      {%- unless post.exclude_from_search == true or excluded_files contains post.path -%}
        {%- assign has_excluded_taxonomy = false -%}
        {%- for tag in post.tags -%}
          {%- if excluded_taxonomies contains tag -%}{%- assign has_excluded_taxonomy = true -%}{%- endif -%}
        {%- endfor -%}
        {%- for category in post.categories -%}
          {%- if excluded_taxonomies contains category -%}{%- assign has_excluded_taxonomy = true -%}{%- endif -%}
        {%- endfor -%}
        {%- unless has_excluded_taxonomy == true -%}
          {%- assign index = index | push: post | uniq -%}
        {%- endunless -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{%- if site.gitbook_search.include.pages == true -%}
  {%- for page in site.html_pages -%}
    {%- unless page.exclude_from_search == true or excluded_files contains page.path -%}
      {%- assign has_excluded_taxonomy = false -%}
      {%- for tag in page.tags -%}
        {%- if excluded_taxonomies contains tag -%}{%- assign has_excluded_taxonomy = true -%}{%- endif -%}
      {%- endfor -%}
      {%- for category in page.categories -%}
        {%- if excluded_taxonomies contains category -%}{%- assign has_excluded_taxonomy = true -%}{%- endif -%}
      {%- endfor -%}
      {%- unless has_excluded_taxonomy == true -%}
        {%- assign index = index | push: page | uniq -%}
      {%- endunless -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endif -%}
{%- for collection in site.gitbook_search.include.collections -%}
  {%- assign documents = site.documents | where:"collection",collection -%}
  {%- for document in documents -%}
    {%- unless document.exclude_from_search == true or excluded_files contains document.path -%}
      {%- assign has_excluded_taxonomy = false -%}
      {%- for tag in document.tags -%}
        {%- if excluded_taxonomies contains tag -%}{%- assign has_excluded_taxonomy = true -%}{%- endif -%}
      {%- endfor -%}
      {%- for category in document.categories -%}
        {%- if excluded_taxonomies contains category -%}{%- assign has_excluded_taxonomy = true -%}{%- endif -%}
      {%- endfor -%}
      {%- unless has_excluded_taxonomy == true -%}
        {%- assign index = index | push: document | uniq -%}
      {%- endunless -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endfor -%}

{%- comment -%}
  Constitutional wording is ordinary text. MESV alternatives live only in
  data-modern attributes on .text-variant spans, so strip_html indexes exactly
  the crawler-visible constitutional edition. Proof bodies are indexed in a
  separate field so excerpts use them only when the match occurs there.
{%- endcomment -%}
{%- assign entries = "" | split: "" -%}
{%- for document in index -%}
  {%- assign doctitle = document.title | smartify | strip_html | normalize_whitespace -%}
  {%- comment -%}
    `order` mirrors the page's nav_order so the search UI can group results in
    the same sequence as the sidebar. Collection order cannot be used: GitHub
    Pages builds with Jekyll 3.10, which sorts collection documents by date then
    path, not by nav_order.
  {%- endcomment -%}
  {%- assign collection = document.category | default: "general" -%}
  {%- assign doccontent = document.content -%}

  {%- comment -%}Remove superscript proof-marker letters from searchable prose.{%- endcomment -%}
  {%- assign proof_parts = doccontent | split: '<sup class="proof-marker">' -%}
  {%- assign clean_parts = "" | split: "" -%}
  {%- assign clean_parts = clean_parts | push: proof_parts.first -%}
  {%- for proof_part in proof_parts offset: 1 -%}
    {%- assign cut = proof_part | split: '</sup>' | first | append: '</sup>' -%}
    {%- assign kept = proof_part | remove_first: cut -%}
    {%- assign clean_parts = clean_parts | push: kept -%}
  {%- endfor -%}
  {%- assign doccontent = clean_parts | join: "" -%}

  {%- if doccontent contains '<span id="' -%}
    {%- assign chunks = doccontent | split: '<span id="' -%}
    {%- for chunk in chunks offset: 1 -%}
      {%- assign secid = chunk | split: '"' | first -%}
      {%- assign marker = secid | append: '"></span>' -%}
      {%- assign section = chunk | remove_first: marker -%}
      {%- assign main = section | split: '<details class="scripture-proofs"' | first -%}
      {%- assign body = main | strip_html | normalize_whitespace | strip -%}
      {%- assign proofs = "" -%}
      {%- if section contains '<div class="proofs-body">' -%}
        {%- assign proofs = section | split: '<div class="proofs-body">' | last | split: '</div>' | first | strip_html | normalize_whitespace | strip -%}
      {%- endif -%}
      {%- assign securl = document.url | append: '#' | append: secid -%}
      {%- assign idparts = secid | split: '-' -%}
      {%- assign keywords = doctitle -%}
      {%- if idparts[0] == 'wcf' -%}
        {%- assign seclabel = 'Chapter ' | append: idparts[1] | append: '.' | append: idparts[2] -%}
        {%- assign reference = 'WCF ' | append: idparts[1] | append: '.' | append: idparts[2] -%}
      {%- elsif idparts[0] == 'wsc' or idparts[0] == 'wlc' -%}
        {%- assign qnum = idparts[1] | remove: 'q' -%}
        {%- assign seclabel = 'Question ' | append: qnum -%}
        {%- assign acronym = idparts[0] | upcase -%}
        {%- assign reference = acronym | append: ' ' | append: qnum -%}
      {%- else -%}
        {%- comment -%}
          An anchor slug is not a citable reference, so leave the badge empty
          rather than printing the raw id.
        {%- endcomment -%}
        {%- assign seclabel = secid -%}
        {%- assign reference = "" -%}
      {%- endif -%}
      {%- assign keywords = keywords | append: ' ' | append: reference -%}
      {%- assign sectitle = doctitle | append: ' — ' | append: seclabel -%}
      {%- comment -%}
        `label` is the extra heading a result row shows beside its reference badge.
        Here the badge ("WCF 1.1", "WSC 33") already says everything seclabel would
        ("Chapter 1.1", "Question 33"), so leave it empty rather than print both.
      {%- endcomment -%}
      {%- assign label = "" -%}
      {%- capture entry -%}{{ securl | relative_url | jsonify }}: {"title": {{ sectitle | jsonify }}, "document": {{ doctitle | jsonify }}, "collection": {{ collection | jsonify }}, "order": {{ document.nav_order | default: 99 }}, "reference": {{ reference | jsonify }}, "label": {{ label | jsonify }}, "keywords": {{ keywords | jsonify }}, "url": {{ securl | relative_url | jsonify }}, "body": {{ body | jsonify }}, "proofs": {{ proofs | jsonify }}}{%- endcapture -%}
      {%- assign entries = entries | push: entry -%}
    {%- endfor -%}
  {%- elsif doccontent contains '<h' -%}
    {%- assign chunks = doccontent | split: '<h' -%}
    {%- for chunk in chunks offset: 1 -%}
      {%- assign lvl = chunk | slice: 0, 1 -%}
      {%- if lvl == '1' or lvl == '2' or lvl == '3' or lvl == '4' or lvl == '5' or lvl == '6' -%}
        {%- assign section = chunk | prepend: '<h' -%}
        {%- assign main = section | split: '<details class="scripture-proofs"' | first -%}
        {%- assign body = main | strip_html | normalize_whitespace | strip -%}
        {%- assign headertag = chunk | split: '>' | first -%}
        {%- assign htext = chunk | split: '</h' | first | split: '>' | last | strip_html | normalize_whitespace | strip -%}
        {%- if headertag contains 'id="' -%}
          {%- assign secid = headertag | split: 'id="' | last | split: '"' | first -%}
          {%- assign securl = document.url | append: '#' | append: secid -%}
        {%- else -%}
          {%- assign securl = document.url -%}
        {%- endif -%}
        {%- assign proofs = "" -%}
        {%- if section contains '<div class="proofs-body">' -%}
          {%- assign proofs = section | split: '<div class="proofs-body">' | last | split: '</div>' | first | strip_html | normalize_whitespace | strip -%}
        {%- endif -%}
        {%- assign keywords = doctitle | append: ' ' | append: htext -%}
        {%- comment -%}
          Assign `reference` unconditionally: Liquid variables outlive the loop, so
          without this a Belgic or church-order section would inherit the last
          Westminster reference set above.
        {%- endcomment -%}
        {%- assign reference = "" -%}
        {%- if doctitle contains 'Heidelberg' -%}
          {%- assign firstword = htext | split: ' ' | first | remove: '.' -%}
          {%- assign keywords = keywords | append: ' Heidelberg ' | append: firstword -%}
          {%- assign reference = 'Heidelberg ' | append: firstword -%}
        {%- endif -%}
        {%- assign sectitle = doctitle | append: ' — ' | append: htext -%}
        {%- capture entry -%}{{ securl | relative_url | jsonify }}: {"title": {{ sectitle | jsonify }}, "document": {{ doctitle | jsonify }}, "collection": {{ collection | jsonify }}, "order": {{ document.nav_order | default: 99 }}, "reference": {{ reference | jsonify }}, "label": {{ htext | jsonify }}, "keywords": {{ keywords | jsonify }}, "url": {{ securl | relative_url | jsonify }}, "body": {{ body | jsonify }}, "proofs": {{ proofs | jsonify }}}{%- endcapture -%}
        {%- assign entries = entries | push: entry -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- comment -%}
      Short documents with no sections (the creeds) index as one whole-page entry:
      the document title is the heading, so there is no separate label or badge.
    {%- endcomment -%}
    {%- assign body = doccontent | strip_html | normalize_whitespace | strip -%}
    {%- capture entry -%}{{ document.url | relative_url | jsonify }}: {"title": {{ doctitle | jsonify }}, "document": {{ doctitle | jsonify }}, "collection": {{ collection | jsonify }}, "order": {{ document.nav_order | default: 99 }}, "reference": "", "label": "", "keywords": {{ doctitle | jsonify }}, "url": {{ document.url | relative_url | jsonify }}, "body": {{ body | jsonify }}, "proofs": ""}{%- endcapture -%}
    {%- assign entries = entries | push: entry -%}
  {%- endif -%}
{%- endfor -%}
{%- assign json_out = entries | join: "," | prepend: "{" | append: "}" -%}
{{ json_out }}
